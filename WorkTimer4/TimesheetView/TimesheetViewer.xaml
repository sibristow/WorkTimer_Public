<adonisControls:AdonisWindow x:Class="WorkTimer4.TimesheetView.TimesheetViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
        xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
        xmlns:local="clr-namespace:WorkTimer4.TimesheetView"
        xmlns:assets="clr-namespace:WorkTimer4.Assets"
        mc:Ignorable="d"   
        x:Name="timesheetWindow"
        Title="{Binding Title}"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}"
        Height="{Binding Height, Mode=TwoWay}" Width="{Binding Width, Mode=TwoWay}">

    <adonisControls:AdonisWindow.TitleBarContent>
        <DockPanel Height="20" Margin="{adonisUi:Space 2}">
            <Image DockPanel.Dock="Left" Source="{x:Static assets:WPFAssets.Time}" Height="16" VerticalAlignment="Center"/>
            <Border Width="1" Margin="16,0,8,0" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased"/>
            <Button Width="32"
                    Style="{DynamicResource {x:Static adonisUi:Styles.WindowButton}}"
                    ToolTip="Open timesheet file" 
                    Command="{Binding OpenFileCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=adonisControls:AdonisWindow}}">
                <Image Source="/Assets/folder.png" Height="16" Width="16"/>
            </Button>
            <Button Style="{DynamicResource {x:Static adonisUi:Styles.WindowButton}}" 
                    Width="32"
                    ToolTip="Show current timesheet" 
                    Command="{Binding RevertToCurrentCommand}">
                <Image Source="/Assets/bullet_go.png" Height="16" Width="16"/>
            </Button>
            <Border Width="1" Margin="8,0" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" SnapsToDevicePixels="True"  RenderOptions.EdgeMode="Aliased"/>
            <TextBlock Margin="8,0" FontWeight="SemiBold" FontSize="14" Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=local:TimesheetViewer}}"/>
        </DockPanel>
    </adonisControls:AdonisWindow.TitleBarContent>
    
    <Grid>
        <Grid.Resources>
            <Style x:Key="PropertyLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding TitleBarActualHeight, RelativeSource={RelativeSource AncestorType={x:Type adonisControls:AdonisWindow}}}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="12" Grid.RowSpan="2"
                BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"/>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="8,0">
            <TextBlock Text="From:" Style="{StaticResource PropertyLabelStyle}"/>
            <DatePicker Margin="8,8,24,8" Width="120" SelectedDate="{Binding From}" Background="White"/>

            <TextBlock Text="To:"  Style="{StaticResource PropertyLabelStyle}"/>
            <DatePicker  Margin="8,8,24,8" Width="120" SelectedDate="{Binding To}" Background="White"/>

            <TextBlock Text="Reporting:" Style="{StaticResource PropertyLabelStyle}"/>
            <TextBox Text="{Binding ReportingFraction}" Margin="8" Width="50" Background="White"/>
        </DockPanel>
        

        <local:AggregatedTimesheetView Grid.Row="2" Grid.ColumnSpan="12" Margin="8"
                                       TimesheetActivities="{Binding Recorded}"
                                       FromFilter="{Binding FromFilter}"
                                       ToFilter="{Binding ToFilter}"
                                       ReportingFraction="{Binding ReportingFraction, Mode=OneWay}"/>

        <GridSplitter Grid.Row="3" Grid.ColumnSpan="12" Height="3" Margin="0,2" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"/>

        <local:TimeLine Grid.Row="4" Grid.ColumnSpan="12" Margin="8" TimeLineActivities="{Binding Recorded}" FromFilter="{Binding FromFilter}" ToFilter="{Binding ToFilter}"/>
    </Grid>
</adonisControls:AdonisWindow>
